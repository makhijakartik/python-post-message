# Copy to .env and fill in real values. Any platform left unset is skipped
# (reported back as status="skipped", not "failed").

# --- Discord ---
# Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# --- Slack ---
# api.slack.com/apps > your app > Incoming Webhooks > Add New Webhook to Workspace
SLACK_WEBHOOK_URL=

# --- Telegram ---
# Create a bot with @BotFather to get the token, add it to your channel/group as admin,
# then use the numeric/@handle chat id it posts to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mastodon ---
# Your instance's Settings > Development > New Application, scope "write:statuses"
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Microsoft Teams ---
# Channel > Connectors (or Workflows "Post to channel when webhook received") > Copy URL
TEAMS_WEBHOOK_URL=
